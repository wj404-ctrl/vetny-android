name: Build VETNY APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download source code
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Unzip VETNY project
        run: |
          mkdir extracted
          find . -name "*.zip" -exec unzip -o {} -d extracted \;

      - name: Locate Android project
        run: |
          PROJECT_DIR=$(find extracted -name settings.gradle -o -name settings.gradle.kts | head -1 | xargs dirname)
          echo "PROJECT_DIR=$PROJECT_DIR" >> $GITHUB_ENV

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Build APK
        run: |
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"
          cd "$PROJECT_DIR"
          gradle assembleDebug

      - name: Upload VETNY APK
        uses: actions/upload-artifact@v4
        with:
          name: VETNY-APK
          path: extracted/**/app/build/outputs/apk/debug/app-debug.apk
